# Anthropic API key for the triage agent (engine/triage_agent.py).
# Leave unset to force the deterministic heuristic fallback (engine/fallback.py).
ANTHROPIC_API_KEY=sk-ant-...

# Resend API key + recipient for severity-gated alerts (engine/alerting.py).
# Leave unset to run the loop with alerts logged but not sent.
RESEND_API_KEY=re_...
ALERT_TO=you@example.com

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-4-6
# RESEND_FROM=Risk Decisioning Loop <onboarding@resend.dev>
